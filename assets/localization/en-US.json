  "surah_fatiha_subtitle": "THE OPENING",
  "surah_fatiha_verse_01_translation": "In the name of Allah, the Entirely Merciful, the Especially Merciful.",
  "surah_fatiha_verse_01_transliteration": "Bismi Allāhi ar-raḥmāni ar-raḥīmi",
  "surah_fatiha_verse_02_translation": "[All] praise is [due] to Allah, Lord of the worlds -",
  "surah_fatiha_verse_02_transliteration": "Al-ḥamdu lillāhi rabbi al-ʿālamīna",
  "surah_fatiha_verse_03_translation": "The Entirely Merciful, the Especially Merciful,",
  "surah_fatiha_verse_03_transliteration": "Ar-raḥmāni ar-raḥīmi",
  "surah_fatiha_verse_04_translation": "Sovereign of the Day of Recompense.",
  "surah_fatiha_verse_04_transliteration": "Māliki yawmi ad-dīni",
  "surah_fatiha_verse_05_translation": "It is You we worship and You we ask for help.",
  "surah_fatiha_verse_05_transliteration": "Iyyāka naʿbudu wa iyyāka nastaʿīnu",
  "surah_fatiha_verse_06_translation": "Guide us to the straight path -",
  "surah_fatiha_verse_06_transliteration": "Ihdinā aṣ-ṣirāṭa al-mustaqīma",
  "surah_fatiha_verse_07_translation": "The path of those upon whom You have bestowed favor, not of those who have evoked Your anger or of those who are astray.",
  "surah_fatiha_verse_07_transliteration": "Ṣirāṭa al-laḏīna anʿamta ʿalayhim ġayri al-maġḍūbi ʿalayhim wa lā aḍ-ḍāllīna",
