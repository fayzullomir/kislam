<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Namoz vaqtlari" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            tools:text="Toshkent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_0" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_1" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_2" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_3" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_4" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cell_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="4dp">
            <ImageView android:id="@+id/icon_5" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/time_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
